# ==============================================================================
# EMPÓRIO DA MÚSICA - AI AGENT CONFIGURATION
# ==============================================================================

# LLM Provider selection: "gemini", "openai", or "mock" (for zero-cost deterministic testing)
LLM_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Configuration (optional fallback or alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (SQLite)
DATABASE_PATH=data/emporio.db
DATA_DIR=data

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

